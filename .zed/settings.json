{
  // Zed with the "Luau" extension: the same luau-lsp settings as .vscode/settings.json.
  "lsp": {
    "luau-lsp": {
      "settings": {
        "roblox": { "enabled": false },
        "fflags": { "enable_new_solver": true },
        "luau-lsp": {
          "platform": { "type": "standard" },
          "sourcemap": { "enabled": false },
          "types": { "definitionFiles": { "@wow": ".deps/wow-forever-luau-types/wow-forever.d.luau" } },
          "ignoreGlobs": ["dist/**", "tests/fail/**", ".deps/**"]
        }
      }
    }
  },
  "languages": {
    "Luau": { "hard_tabs": true, "tab_size": 4, "preferred_line_length": 120 }
  }
}
