root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{luau,lua}]
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{md,yml,yaml,json,json5,toml}]
indent_style = space
indent_size = 2

[*]
end_of_line = lf
max_line_length = 120

[*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,json5,yaml,yml,toml,md,markdown,mdx,css,scss,less,astro}]
indent_style = space
indent_size = 2

[*.{lua,luau}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.rs]
indent_style = space
indent_size = 4
