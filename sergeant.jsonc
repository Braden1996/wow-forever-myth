{
  "$schema": "./.sergeant/schema.json",
  "plugins": [
    "ts",
    "bun",
    "oxlint",
    "astro",
    "luau",
    "lune",
    "woof",
    "wow",
    "actionlint",
    "zizmor",
    "lychee",
    "secrets",
  ],
  "packages": ["packages/libraries/*/*/*", "packages/runtimes/*"],
  "boundaries": {
    "noUnitCycles": true,
  },
  "tasks": {
    "bundle": {
      "run": ["lune", "run", "packages/runtimes/cli/src/build.effect", "${@wow-forever-myth/wow-bundle:build}"],
      "mode": "live",
    },
  },
  "commands": {
    "generate": {
      "run": ["lune", "run", "packages/runtimes/cli/src/main"],
    },
    "banner": {
      "run": ["lune", "run", "packages/runtimes/cli/src/banner.effect"],
    },
    "fixtures-update": {
      "run": ["lune", "run", "packages/runtimes/cli/src/fixtures.effect", "--update"],
    },
  },
  "manager": "bun",
  "typescript": {
    "tsconfig": "repo",
  },
  "cache": {
    "untrackable": "degrade",
  },
  "check": {
    "fresh": {
      "run": ["lune", "run", "packages/runtimes/cli/src/main", "--check"],
      "cache": false,
      "inputs": [
        "packages/runtimes/cli/src/main.luau",
        "packages/libraries/luau/pure/generator/src/**",
        "packages/libraries/luau/wow/forever-myth/src/Api/**",
        "packages/libraries/luau/wow/forever-myth/src/Widgets/**",
        "packages/libraries/luau/wow/forever-myth/src/ApiIndex.luau",
        "packages/libraries/luau/wow/forever-myth/src/WidgetIndex.luau",
        "luau_packages/wow-types/api-shapes.json",
        ".editorconfig",
      ],
      "tools": ["sgt"],
    },
    "fixtures": {
      "run": ["lune", "run", "packages/runtimes/cli/src/fixtures.effect"],
      "cache": false,
      "inputs": [
        "packages/runtimes/cli/src/fixtures.effect.luau",
        "packages/libraries/luau/wow/forever-myth/src/**",
        "tests/pass/**",
        "tests/fail/**",
        ".luaurc",
        "luau_packages/truemyth/src/**",
        "luau_packages/wow-types/wow-forever.d.luau",
      ],
      "tools": ["luau-lsp"],
    },
    "banner-fresh": {
      "run": ["lune", "run", "packages/runtimes/cli/src/banner.effect", "--check"],
      "cache": false,
      "inputs": [
        "packages/runtimes/cli/src/banner.effect.luau",
        "packages/libraries/luau/pure/generator/src/**",
        "luau_packages/wow-types/api-shapes.json",
        ".github/banner.svg",
      ],
    },
    "bundle-specs": {
      "run": ["lune", "run", "packages/runtimes/cli/src/test.effect", "${@wow-forever-myth/wow-bundle:build}"],
      "cache": false,
      "inputs": [
        "packages/runtimes/cli/src/**",
        "packages/libraries/luau/pure/generator/src/**",
        "packages/libraries/luau/wow/forever-myth/src/ForeverMyth.luau",
        "tests/spec/**",
        "luau_packages/wow-types/api-shapes.json",
        "LICENSE",
        "luau_packages/truemyth/LICENSE",
        "dist/ForeverMyth.lua",
      ],
    },
    "luajit-smoke": {
      "run": ["luajit", "tests/lua51/run.lua", "dist/ForeverMyth.lua"],
      "cache": false,
      "inputs": ["tests/lua51/run.lua", "dist/ForeverMyth.lua"],
    },
  },
}
