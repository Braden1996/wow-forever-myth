{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Site source (DOM + React)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Astro and Vite resolve modules the bundler way (virtual `astro:*` modules, extensionless imports in
    // astro/client.d.ts), so the site source uses Bundler resolution; config and test code stay on NodeNext.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["astro/client"],
    // Same exception as the Astro runtime in the Higher monorepo: Astro's own declarations do not pass
    // `skipLibCheck: false` (missing @astrojs/markdown-remark types, duplicate content-module declarations,
    // `export =` in client.d.ts). This skips checking .d.ts files only; every file in src/ is still checked.
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": [".astro/types.d.ts", "src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
