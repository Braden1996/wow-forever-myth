{
  "name": "wow-forever-myth-docs",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation site for wow-forever-myth (Astro + Starlight, static for GitHub Pages).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "bun run typecheck:ts && bun run typecheck:astro",
    "typecheck:ts": "bun run tsgo -p tsconfig.src.json && bun run tsgo -p tsconfig.test.json && bun run tsgo -p tsconfig.aux.json",
    "tsgo": "node node_modules/@typescript/native/bin/tsc",
    "typecheck:astro": "astro sync && astro check --tsconfig tsconfig.src.json",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "links": "bun scripts/check-links.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "luau-web-checker": "https://github.com/Braden1996/luau-web-checker/releases/download/v0.4.0/luau-web-checker-0.4.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "starlight-luau": "0.1.0",
    "starlight-warcraft": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.1"
  }
}
